# Same Neon database as the main Urawise app (quote requests go to the renovation_leads table).
DATABASE_URL=
# Resend, for the email with each quote request. Without it the request is still saved.
RESEND_API_KEY=
# Meta Conversions API (the form's Lead, server-side). Events Manager → the pixel → Settings → Conversions API →
# Generate access token. Without it the Lead is still sent by the browser pixel only.
META_CAPI_ACCESS_TOKEN=
# Optional, only while testing: the code from Events Manager → Test Events. Remove it afterwards.
# META_CAPI_TEST_EVENT_CODE=
# Optional; these are the defaults.
# EMAIL_FROM=UraWise <notifications@urawise.eu>
# EMAIL_REPLY_TO=ek@workguardai.com
